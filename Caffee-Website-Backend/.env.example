# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
EMAIL_USER=
# use a Gmail App Password, not your account password
EMAIL_PASS=
COMPANY_EMAIL=
